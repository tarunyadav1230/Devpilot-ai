# Required: OpenRouter API Key for LLM Agents
OPENROUTER_API_KEY=

# Redis Connection URL (Use redis://redis:6379/0 in Docker, redis://localhost:6379/0 locally)
REDIS_URL=redis://localhost:6379/0

# Optional: External Web Search API (Defaults to free zero-config DuckDuckGo search if empty)
TAVILY_API_KEY=

# Optional: LangSmith Observability & Tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=devpilot-ai

# Frontend API Base URL (Used during Vite build, defaults to http://localhost:8000)
VITE_API_BASE=http://localhost:8000
